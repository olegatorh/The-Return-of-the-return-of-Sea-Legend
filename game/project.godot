config_version=5

[application]
config/name="Sea Dogs (port)"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]
window/size/viewport_width=720
window/size/viewport_height=540
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]
file_logging/enable_file_logging=true
file_logging/max_log_files=5

[dotnet]
project/assembly_name="SeaDogs"

[rendering]
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
